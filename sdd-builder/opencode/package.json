{
  "name": "opencode-sdd-builder",
  "version": "1.5.0",
  "description": "Fluxo SDD com PRD, specs, especialistas e soluções multiprojeto para OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArquitetoMovel/markv-ai-plugins.git",
    "directory": "sdd-builder/opencode"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "opencode-sdd-builder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run check && npm test",
    "test:integration": "npm run check && npm test && node scripts/integration.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
